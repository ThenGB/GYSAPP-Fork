# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
# pubspec.lock

# Directory created by dartdoc
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# FVM Version Cache
.fvm/

# IDE
.idea/
*.iml
.vscode/

# AI Agent configs & tools (non-opencode, already removed from project)
.kilo/
.claude/
.codex/
.superpowers/
.devin/
.serena/
.playwright-mcp/
.reasonix/
reasonix.toml
.mcp.json

# Node.js (ECC plugin for opencode)
node_modules/

# Agent / debug logs
*.log
.codex-reset-debug*.err.log
.codex-reset-debug*.out.log

# Debug and temp files
null
submit_command.json
commit_message.txt
deps.txt
test_script.py

# Stitch generated designs
stitch_kidung_rohani_gys/

# Screenshots (not part of app)
screenshots/
*.png

# flutter_native_splash creates Android 12 branding PNGs in previously
# non-tracked resource paths. Keep these generated runtime resources even
# though arbitrary screenshots/PNGs remain ignored above.
!android/app/src/main/res/drawable-*/android12branding.png
!android/app/src/main/res/drawable-night-*/android12branding.png

# Original PDF and DB sources
Original Alkitab DB/
Original PDF/

# Docs folder
docs/

# Google Fonts downloaded for local development only. The app no longer
# declares this ignored directory as a required bundled asset.
google_fonts/

# macOS metadata
.metadata
devtools_options.yaml
church.iml

# Android Kotlin errors
android/.kotlin/
