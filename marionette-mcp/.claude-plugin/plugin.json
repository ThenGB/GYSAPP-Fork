{
  "name": "marionette-mcp",
  "version": "1.0.0",
  "description": "MCP server integration for AI agents to interact with running Flutter applications at runtime. Enables widget inspection, tap simulation, text entry, scrolling, screenshots, and hot reload.",
  "author": {
    "name": "LeanCode",
    "url": "https://github.com/leancodepl/marionette_mcp"
  },
  "homepage": "https://github.com/leancodepl/marionette_mcp",
  "repository": "https://github.com/leancodepl/marionette_mcp",
  "license": "MIT",
  "keywords": ["flutter", "debugging", "testing", "mcp", "mobile-development"],
  "mcpServers": {
    "marionette": {
      "command": "dart",
      "args": ["pub", "global", "run", "marionette_mcp"],
      "env": {
        "LOG_LEVEL": "info"
      }
    }
  }
}